# ─────────────────────────────────────────────────────────────
# AI Atlas — environment configuration
# Everything is optional: with no variables set, the app runs on a local
# JSON store (.data/atlas.json) and shows clearly labelled DEMO content until
# real news has been ingested.
# ─────────────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────────────
# PostgreSQL / Supabase connection string (server-side only).
# Apply schema with: npm run db:migrate
# DATABASE_URL=postgres://postgres:password@localhost:5432/atlas
# PG_POOL_SIZE=5
# Path of the local JSON store when DATABASE_URL is unset.
# LOCAL_STORE_PATH=.data/atlas.json

# Demo content: auto (default: only when no real articles exist) | on | off
# DEMO_MODE=auto

# ── Ingestion ────────────────────────────────────────────────
# Interval for `npm run ingest:watch` and the in-process scheduler (min 5).
# INGEST_INTERVAL_MINUTES=20
# Run ingestion inside the Next.js server (long-running Node hosts only).
# INGEST_SCHEDULER=on
# Secret for GET /api/cron/ingest (Authorization: Bearer <CRON_SECRET>).
# CRON_SECRET=change-me

# RSS/Atom (no key). Disable defaults or add feeds: url|name|publisherCountry|reliability;...
# RSS_DEFAULT_FEEDS=on
# RSS_FEEDS=https://example.org/ai/feed.xml|Example Daily|FR|0.7
# INGEST_RSS=on

# GDELT DOC 2.0 (no key).
# INGEST_GDELT=on
# GDELT_QUERY=("artificial intelligence" OR "generative AI") sourcelang:english
# GDELT_TIMESPAN=2h

# Event Registry / NewsAPI.ai (requires key)
# EVENT_REGISTRY_API_KEY=
# EVENT_REGISTRY_KEYWORD=artificial intelligence

# NewsAPI.org (requires key; check plan terms for production use)
# NEWSAPI_KEY=
# NEWSAPI_QUERY="artificial intelligence"

# INGEST_USER_AGENT=AIAtlasBot/1.0 (+https://your-domain.example/about)

# ── Optional LLM enrichment (summaries + classification review) ──
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_ENRICHMENT=on

# ── Admin console (/admin) ───────────────────────────────────
# Required in production; without it /admin is open in development only.
# ADMIN_TOKEN=

# ── Optional accounts (Supabase Auth, magic link) ────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
